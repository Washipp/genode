 /**
@@ -206,6 +207,11 @@ typedef struct afl_forkserver {
   s32                   nyx_log_fd;
 #endif
 
+  s32 shm_id_trace_bits; /* used for the tracebits */
+  s32 shm_id_fuzzing; /* used for shared memory fuzzing */
